# ========================================
# OpenClaw WhatsApp Guardian Configuration
# ========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ------------------------------------------
# OpenAI Configuration (Required)
# ------------------------------------------
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=1000
OPENAI_TEMPERATURE=0.7

# ------------------------------------------
# WhatsApp Configuration
# ------------------------------------------
WHATSAPP_SESSION_NAME=guardian
WHATSAPP_AUTH_DIR=./data/auth

# Optional: Phone number for pairing code authentication
# If set, pairing code will be displayed instead of QR code
# Format: country code + number, no + or spaces (e.g., 491234567890)
WHATSAPP_PHONE_NUMBER=

# ------------------------------------------
# Data Directories
# ------------------------------------------
INBOX_DIR=./data/inbox
OUTBOX_DIR=./data/outbox
CONFIG_DIR=./config

# ------------------------------------------
# Conversation Memory
# ------------------------------------------
# How long to keep conversations (days)
MEMORY_RETENTION_DAYS=30

# Maximum messages to include in context
MEMORY_MAX_MESSAGES=15

# Maximum tokens for conversation history
MEMORY_MAX_TOKENS=50000

# ------------------------------------------
# Logging
# ------------------------------------------
# Options: trace, debug, info, warn, error, fatal
LOG_LEVEL=info

# ------------------------------------------
# Environment
# ------------------------------------------
NODE_ENV=production

# ------------------------------------------
# Security
# ------------------------------------------
# Maximum message length (characters)
MESSAGE_MAX_LENGTH=4000

# Blocked senders (comma-separated phone numbers)
# Messages from these numbers will be ignored
BLOCKED_SENDERS=

# ------------------------------------------
# Web Server (QR Login Page)
# ------------------------------------------
WEB_PORT=3333

# ------------------------------------------
# Webhook (Optional)
# ------------------------------------------
# Enable webhook notifications when messages are escalated
WEBHOOK_ENABLED=false

# URL to POST escalation notifications to
WEBHOOK_URL=http://localhost:3000/api/webhook/guardian

# Webhook timeout in milliseconds
WEBHOOK_TIMEOUT=5000

# Number of retry attempts for failed webhooks
WEBHOOK_MAX_RETRIES=3
