{
  "name": "openclaw-whatsapp-guardian",
  "version": "1.0.0",
  "description": "AI-powered WhatsApp Guardian - Intelligent message filtering and routing for AI agents",
  "main": "dist/index.js",
  "scripts": {
    "build": "./node_modules/.bin/tsc && npm run copy-public",
    "copy-public": "mkdir -p dist/web/public && cp src/web/public/index.html dist/web/public/",
    "start": "node dist/index.js",
    "start:web": "node dist/index.js --mode=web",
    "dev": "nodemon --exec ts-node src/index.ts",
    "dev:web": "nodemon --exec ts-node src/index.ts --mode=web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "echo \"Tests coming soon\" && exit 0"
  },
  "keywords": [
    "whatsapp",
    "ai",
    "guardian",
    "filter",
    "chatbot",
    "openai",
    "gpt",
    "openclaw",
    "message-routing",
    "customer-service",
    "automation",
    "baileys"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openclaw/whatsapp-guardian.git"
  },
  "bugs": {
    "url": "https://github.com/openclaw/whatsapp-guardian/issues"
  },
  "homepage": "https://github.com/openclaw/whatsapp-guardian#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^6.7.0",
    "better-sqlite3": "^12.6.2",
    "chokidar": "^3.5.3",
    "dotenv": "^16.4.1",
    "express": "^5.2.1",
    "gray-matter": "^4.0.3",
    "js-tiktoken": "^1.0.21",
    "openai": "^4.28.0",
    "pino": "^8.17.2",
    "pino-pretty": "^13.1.3",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "socket.io": "^4.8.3",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.31",
    "@types/qrcode": "^1.5.5",
    "@types/uuid": "^10.0.0",
    "nodemon": "^3.0.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
